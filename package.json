{
  "name": "swingscout",
  "private": true,
  "version": "0.1.0",
  "description": "Personal end-of-day swing-trading stock scanner. Reads a nightly-refreshed data.json; no live backend, no API keys in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/run-all.js",
    "test:indicators": "node scripts/test_indicators.js",
    "test:filters": "node tests/filters.test.js",
    "test:verdict": "node tests/verdict.test.js",
    "test:data-fetch": "node tests/data-fetch.test.js",
    "test:rate-limit": "node tests/rate-limit.test.js",
    "test:network": "node tests/network.test.js",
    "refresh": "node scripts/refresh.js",
    "refresh:demo": "node scripts/refresh.js --demo",
    "verify:goog": "node scripts/verify_goog.js"
  },
  "dependencies": {
    "lightweight-charts": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.2"
  }
}
